<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dino_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:padding="8dp">

    <!-- Header bar: Score and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LIE RUNNER"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#22c55e" />

        <TextView
            android:id="@+id/dino_score_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="СЧЁТ: 0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#ffffff" />
    </LinearLayout>

    <!-- Game Track Area -->
    <FrameLayout
        android:id="@+id/dino_game_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp">

        <!-- Ground Line -->
        <View
            android:id="@+id/dino_ground_line"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:background="#30363d" />

        <!-- Runner Character (Left side) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <!-- Jump spacer that expands when jumping -->
            <View
                android:id="@+id/dino_jump_spacer"
                android:layout_width="1dp"
                android:layout_height="0dp" />

            <ImageView
                android:id="@+id/dino_character_img"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/lie_runner_1"
                android:contentDescription="LieVPN Runner" />
        </LinearLayout>

        <!-- Dynamic Obstacle Track using 3 slots across screen -->
        <!-- Slot 1 (far right) -->
        <LinearLayout
            android:id="@+id/dino_obstacle_slot_far"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/dino_obstacle_img_far"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/obs_rkn"
                android:contentDescription="Obstacle" />
        </LinearLayout>

        <!-- Slot 2 (middle) -->
        <LinearLayout
            android:id="@+id/dino_obstacle_slot_mid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/dino_obstacle_img_mid"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/obs_yandex"
                android:contentDescription="Obstacle" />
        </LinearLayout>

        <!-- Slot 3 (near runner, danger zone) -->
        <LinearLayout
            android:id="@+id/dino_obstacle_slot_near"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="58dp"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/dino_obstacle_img_near"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/obs_vk"
                android:contentDescription="Obstacle" />
        </LinearLayout>

    </FrameLayout>

    <!-- Tap Hint at bottom -->
    <TextView
        android:id="@+id/dino_hint_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center"
        android:text="Тапни чтобы перепрыгнуть!"
        android:textSize="9sp"
        android:textColor="#8b949e" />

</FrameLayout>
